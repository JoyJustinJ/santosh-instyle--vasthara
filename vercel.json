{
    "rewrites": [
        {
            "source": "/((?!api/.*|MySanthoshapp\\.apk|vastra\\.apk).*)",
            "destination": "/index.html"
        }
    ],
    "headers": [
        {
            "source": "/MySanthoshapp.apk",
            "headers": [
                { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
                { "key": "Content-Disposition", "value": "attachment; filename=\"MySanthoshapp.apk\"" },
                { "key": "Cache-Control", "value": "no-cache" }
            ]
        }
    ]
}
